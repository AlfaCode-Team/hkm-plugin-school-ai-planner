{
    "name": "alfacode-team/hkm-plugin-school-ai-planner",
    "description": "AI-assisted lesson sheets (fiches pedagogiques), questionnaires and teacher evaluations.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\SchoolAiPlanner\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\SchoolAiPlanner\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
